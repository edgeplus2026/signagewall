# Flatten node_modules like npm so Vite/Nest and their plugins resolve
# transitive deps without phantom-dependency breakage during the monorepo
# migration. Can be tightened later once deps are declared explicitly.
shamefully-hoist=true

# Don't run a full `install` before every script. The build-script approval for
# native deps is handled explicitly via allowBuilds in the workspace file; the
# pre-run check otherwise fails on the ignored @scarf/scarf telemetry.
verify-deps-before-run=false
