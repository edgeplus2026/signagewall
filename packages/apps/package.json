{
  "name": "@edge/apps",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --sourcemap && tsc -p tsconfig.json --emitDeclarationOnly && pnpm run build:embeds",
    "build:embeds": "vite build --config vite.embeds.config.ts",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.embeds.json"
  },
  "dependencies": {
    "@edge/apps-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "hls.js": "^1.6.16",
    "qrcode": "^1.5.4",
    "tsup": "^8.3.5",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
