VITE_API_URL=http://localhost:3000/api/v1

# Sentry error tracking. Leave blank to disable (also disabled in local dev).
VITE_SENTRY_DSN=
# Optional environment label shown in Sentry; defaults to the build mode.
VITE_SENTRY_ENVIRONMENT=

# --- Cloud media import (public picker credentials) ---------------------------
# Each provider's picker stays hidden until its credentials are set. These are
# public client identifiers (safe to ship to the browser); no secrets here.

# Google Drive + Google Photos — Google Cloud Console: enable the Picker API,
# Drive API and Google Photos Picker API; create an OAuth Web client + API key.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
# Optional GCP project number (improves Picker behavior).
VITE_GOOGLE_APP_ID=

# OneDrive + SharePoint — Azure Portal (Entra ID): register a multi-tenant SPA
# app ("any org directory + personal Microsoft accounts").
VITE_MS_CLIENT_ID=
# Authority: keep ".../common" to accept BOTH personal and any work/school
# tenant. Use ".../consumers" for personal-only, or ".../<tenant-id>" to lock to
# one company. Defaults to ".../common" when blank.
VITE_MS_AUTHORITY=
# Optional override of the SharePoint site base, e.g. https://contoso.sharepoint.com.
# Leave BLANK to auto-detect the signed-in user's tenant per login (recommended,
# multi-tenant): the OneDrive/SharePoint roots are derived via Microsoft Graph.
VITE_MS_SHAREPOINT_BASE=

# Dropbox — App Console: create an app, enable the Chooser, and allowlist your
# domain(s). Only the app key is needed.
VITE_DROPBOX_APP_KEY=


