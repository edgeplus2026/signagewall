VITE_API_URL=http://localhost:3000/api/v1
VITE_PLAYER_URL=http://localhost:5174

# Optional. Origin of the realtime websocket. Leave EMPTY in every environment:
# unset, it is derived from VITE_API_URL's origin, which is always right. Set it
# only to point the socket somewhere other than the API.
VITE_WS_URL=

# Optional. Marketing site origin — the CMS links to the published legal
# documents there. Default https://www.signagewall.com.
VITE_WEB_URL=

# Optional. Base path the app embed bundles are served from. Default /apps.
VITE_APPS_BASE=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_APP_ID=

VITE_MS_CLIENT_ID=
VITE_MS_AUTHORITY=

VITE_DROPBOX_APP_KEY=