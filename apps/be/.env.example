NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/edge

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-secret
JWT_REFRESH_SECRET=replace-with-another-32-characters-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Mail — disabled by default locally; set MAIL_ENABLED=true in production
MAIL_ENABLED=false
# Resend — free tier: https://resend.com (3000 emails/month)
RESEND_API_KEY=
MAIL_FROM=Edge <onboarding@resend.dev>
# Where feedback and problem reports are delivered
MAIL_SUPPORT_TO=you@example.com

PASSWORD_RESET_EXPIRES_IN_HOURS=1
INVITE_EXPIRES_IN_DAYS=7

# Rate limiting (per client IP)
# Global default: applied to all routes
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Stricter limit for sensitive auth/invite routes (login, register, reset, refresh, invite preview)
THROTTLE_AUTH_TTL_SECONDS=60
THROTTLE_AUTH_LIMIT=10

# OpenAPI / Swagger UI (enabled by default in development)
# SWAGGER_ENABLED=true

# Cloudflare R2 (S3-compatible media storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
# S3 Secret Access Key from the R2 token screen, or the cfat_/cfut_ token value (hashed automatically)
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for serving uploaded files (custom domain or R2 dev URL)
R2_PUBLIC_URL=

# Media upload limits
MEDIA_MAX_FILE_SIZE_BYTES=10485760
MEDIA_MAX_FILES_PER_UPLOAD=10

# Stock media (Pexels) — https://www.pexels.com/api/
PEXELS_API_KEY=
PEXELS_API_BASE_URL=https://api.pexels.com
# Max size for a stock asset imported into the library (default 50 MB)
STOCK_MEDIA_MAX_IMPORT_BYTES=52428800