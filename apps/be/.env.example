NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/edge

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-secret
JWT_REFRESH_SECRET=replace-with-another-32-characters-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Microsoft (Azure AD / Entra ID / Graph) OAuth — powers Microsoft connected
# apps: Outlook Calendar, Teams, and PowerPoint (OneDrive / SharePoint). Register
# an app at the Entra admin center (App registrations), add the connection
# callback as a redirect URI, and create a client secret. TENANT 'common' allows
# any work/school/personal account; set a tenant id for single-tenant. The
# PowerPoint slide renderer also needs the `pdftoppm` binary (poppler-utils)
# installed on the host/image.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Meta (Facebook / Instagram Graph) OAuth — for the Instagram and Facebook Page
# connected apps. Create an app at developers.facebook.com, add the Facebook
# Login product, set the connection callback as a Valid OAuth Redirect URI, and
# copy the App ID / App Secret here. Reading a business Instagram feed or a Page
# feed needs the relevant permissions granted via Meta App Review + Business
# verification before the app can be used with accounts you don't own.
META_CLIENT_ID=
META_CLIENT_SECRET=

# Canva OAuth (Connect API) — for the Canva connected app. Create a Connect API
# integration at https://www.canva.com/developers, register the connection
# callback as the redirect URL, and copy the client id/secret here. Uses PKCE.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# AES-256-GCM key for encrypting third-party OAuth tokens at rest.
# Generate with: openssl rand -base64 32
# WITHOUT IT, connected apps (Google Calendar, Canva) are disabled entirely.
ENCRYPTION_KEY=

# Publicly reachable HTTPS base URL of this API. Two things need it, and both are
# things a provider calls back into — so localhost is not a substitute for either:
#   1. connection OAuth callbacks
#   2. provider PUSH notifications (Google Calendar `events.watch`, Google Drive
#      `files.watch` for the Sheets / Slides / menu-board syncs, Microsoft Graph
#      change-subscriptions for the PowerPoint app)
# Leave it unset in development: connectors then simply don't subscribe, and the
# poll cadence keeps the screens current on its own (Google Calendar: every 5 min).
# Set it in production and a calendar edit reaches the screen in seconds.
PUBLIC_API_URL=

# Optional: receive provider webhooks (Microsoft Graph — PowerPoint app) on a
# LOCAL machine. Graph must reach the API over public HTTPS, so run a tunnel and
# put its URL here — OAuth callbacks keep using PUBLIC_API_URL/localhost, only
# webhook notifications go through the tunnel:
#   cloudflared tunnel --url http://localhost:3000   (or: ngrok http 3000)
#   WEBHOOK_PUBLIC_URL=https://<your-tunnel-subdomain>.trycloudflare.com
# Then restart the backend and re-save the PowerPoint app config to (re)create
# the Graph subscription. Unset: falls back to PUBLIC_API_URL.
WEBHOOK_PUBLIC_URL=

# Mail — disabled by default locally; set MAIL_ENABLED=true in production
MAIL_ENABLED=false
# Resend — free tier: https://resend.com (3000 emails/month)
RESEND_API_KEY=
MAIL_FROM=Edge <onboarding@resend.dev>
# Where feedback and problem reports are delivered
MAIL_SUPPORT_TO=you@example.com
# Where new-user registration notifications are delivered
MAIL_REGISTRATIONS_NOTIFY_TO=edgeplus2026@gmail.com

PASSWORD_RESET_EXPIRES_IN_HOURS=1
INVITE_EXPIRES_IN_DAYS=7

# Rate limiting (per client IP)
# Global default: applied to all routes
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Stricter limit for sensitive auth/invite routes (login, register, reset, refresh, invite preview)
THROTTLE_AUTH_TTL_SECONDS=60
THROTTLE_AUTH_LIMIT=10

# OpenAPI / Swagger UI (enabled by default in development)
# SWAGGER_ENABLED=true

# Cloudflare R2 (S3-compatible media storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
# S3 Secret Access Key from the R2 token screen, or the cfat_/cfut_ token value (hashed automatically)
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for serving uploaded files (custom domain or R2 dev URL)
R2_PUBLIC_URL=

# Media upload limits
MEDIA_MAX_FILE_SIZE_BYTES=10485760
MEDIA_MAX_FILES_PER_UPLOAD=10

# Stock media (Pexels) — https://www.pexels.com/api/
PEXELS_API_KEY=
PEXELS_API_BASE_URL=https://api.pexels.com
# Max size for a stock asset imported into the library (default 50 MB)
STOCK_MEDIA_MAX_IMPORT_BYTES=52428800

# Redis — backs the BullMQ queue for the AI content generator.
# Locally: `docker compose up -d redis`. In production prefer a full REDIS_URL
# (e.g. rediss://:password@host:6379) and set REDIS_TLS=true.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# AI content generator (OpenRouter) — https://openrouter.ai/keys
# Leave OPENROUTER_API_KEY blank to disable the feature. The model is swappable;
# the default is a free model (verify the current id on openrouter.ai/models).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=60000
# Optional attribution headers OpenRouter recommends
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=Edge CMS
# Generations allowed per user per UTC day
AI_CONTENT_DAILY_LIMIT=10
# Number of slides requested from the model (never asked of the user)
AI_CONTENT_DEFAULT_SLIDES=5
