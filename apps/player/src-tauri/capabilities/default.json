{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Kiosk shell capabilities for the main window (incl. the remote player origin).",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:5174", "https://REPLACE_PROD_ORIGIN"]
  },
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "process:default",
    "autostart:allow-enable",
    "autostart:allow-is-enabled"
  ]
}
