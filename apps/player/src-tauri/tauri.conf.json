{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EdgeRize Player",
  "version": "0.1.0",
  "identifier": "com.edgerize.player",
  "build": {
    "beforeDevCommand": "node src-tauri/scripts/prepare-watchdog.mjs && pnpm --filter @edge/player dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "node src-tauri/scripts/prepare-watchdog.mjs --release && pnpm --filter @edge/player build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEMEREQjI4RkI2MEUzRUUKUldUdTQyRDdLTnNOTFQyNHJqbGFPeTNFNUlhOUpGb0xlMUpTK3NQYnBkTjl0L3FEWDJHSmZhcmQK",
      "endpoints": ["http://localhost:9099/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/edge-watchdog"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
