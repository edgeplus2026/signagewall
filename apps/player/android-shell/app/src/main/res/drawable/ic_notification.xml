<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon for the watchdog's foreground-service notification and the
  recovery ladder's full-screen intent.

  Its own drawable rather than the launcher foreground: a notification icon is a
  24dp flat silhouette whose colour the system throws away and re-tints, and it is
  expected to FILL its canvas. The launcher foreground is 108dp art deliberately
  inset into an adaptive-icon safe zone, so reusing it puts a small mark in the
  middle of a mostly-empty status-bar slot.

  Same mark, same 60x60 source coordinates, scaled to fill 24dp instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:scaleX="0.393"
        android:scaleY="0.393"
        android:translateX="0.21"
        android:translateY="0.22">

        <path
            android:fillColor="#00000000"
            android:pathData="M5.5,12 H20.5 A1.5,1.5 0 0 1 22,13.5 V24.5 A1.5,1.5 0 0 1 20.5,26 H5.5 A1.5,1.5 0 0 1 4,24.5 V13.5 A1.5,1.5 0 0 1 5.5,12 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4" />

        <path
            android:fillColor="#FFFFFF"
            android:pathData="M31.5,10 H54.5 A3.5,3.5 0 0 1 58,13.5 V24.5 A3.5,3.5 0 0 1 54.5,28 H31.5 A3.5,3.5 0 0 1 28,24.5 V13.5 A3.5,3.5 0 0 1 31.5,10 Z" />

        <path
            android:fillColor="#00000000"
            android:pathData="M5.5,34 H28.5 A1.5,1.5 0 0 1 30,35.5 V46.5 A1.5,1.5 0 0 1 28.5,48 H5.5 A1.5,1.5 0 0 1 4,46.5 V35.5 A1.5,1.5 0 0 1 5.5,34 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4" />

        <path
            android:fillColor="#00000000"
            android:pathData="M39.5,34 H54.5 A1.5,1.5 0 0 1 56,35.5 V46.5 A1.5,1.5 0 0 1 54.5,48 H39.5 A1.5,1.5 0 0 1 38,46.5 V35.5 A1.5,1.5 0 0 1 39.5,34 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4" />
    </group>
</vector>
