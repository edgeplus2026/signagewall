<?xml version="1.0" encoding="utf-8"?>
<!--
  The SignageWall mark: four screens in a wall, one of them playing. Transcribed
  from apps/player/public/brand/signagewall-mark.svg — same 60x60 coordinate space,
  same colours, with each <rect> written out as a <path> because VectorDrawable has
  no rect primitive. Keep the two in step: this is a copy, not a reference.

  The group scales that 60x60 art into the adaptive icon's safe zone. At 0.95 the
  far corner of the artwork lands 32.7dp from the centre, just inside the 33dp
  radius a round launcher mask keeps — so no corner of the wall gets clipped off.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:translateX="25.5"
        android:translateY="25.5">

        <!-- Top-left screen (outline). -->
        <path
            android:fillColor="#00000000"
            android:pathData="M5.5,12 H20.5 A1.5,1.5 0 0 1 22,13.5 V24.5 A1.5,1.5 0 0 1 20.5,26 H5.5 A1.5,1.5 0 0 1 4,24.5 V13.5 A1.5,1.5 0 0 1 5.5,12 Z"
            android:strokeColor="@color/brand_ink"
            android:strokeWidth="4" />

        <!-- Top-right screen — the one that is playing, and the only filled shape. -->
        <path
            android:fillColor="@color/brand_orange"
            android:pathData="M31.5,10 H54.5 A3.5,3.5 0 0 1 58,13.5 V24.5 A3.5,3.5 0 0 1 54.5,28 H31.5 A3.5,3.5 0 0 1 28,24.5 V13.5 A3.5,3.5 0 0 1 31.5,10 Z" />

        <!-- Bottom-left screen (outline). -->
        <path
            android:fillColor="#00000000"
            android:pathData="M5.5,34 H28.5 A1.5,1.5 0 0 1 30,35.5 V46.5 A1.5,1.5 0 0 1 28.5,48 H5.5 A1.5,1.5 0 0 1 4,46.5 V35.5 A1.5,1.5 0 0 1 5.5,34 Z"
            android:strokeColor="@color/brand_ink"
            android:strokeWidth="4" />

        <!-- Bottom-right screen (outline). -->
        <path
            android:fillColor="#00000000"
            android:pathData="M39.5,34 H54.5 A1.5,1.5 0 0 1 56,35.5 V46.5 A1.5,1.5 0 0 1 54.5,48 H39.5 A1.5,1.5 0 0 1 38,46.5 V35.5 A1.5,1.5 0 0 1 39.5,34 Z"
            android:strokeColor="@color/brand_ink"
            android:strokeWidth="4" />
    </group>
</vector>
