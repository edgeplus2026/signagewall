<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Not for drawing anything: it is the one exemption a normal app can hold
         from Android's background-activity-launch block, which is what stops the
         keep-alive from putting the player back after something knocks it off the
         screen. Measured on an Android 14 TV: 1/5 recoveries without it (and that
         one only inside the ~10s grace period), 5/5 in ~4s with it. Granted by the
         operator once, from the service bar — see requestOverlayPermission. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The recovery ladder's second rung is a full-screen-intent notification: a
         background-activity-launch exemption DISTINCT from the overlay permission,
         so it can work where the first rung is refused. Both permissions are
         required for it to be anything at all — without them the notification is
         posted, silently dropped, and the rung is a no-op that looks like a
         working escalation in the log. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Level 3: prompted APK self-update on non-Device-Owner devices. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets the player update ITSELF without the system's install prompt (Android
         12+). A normal permission — granted at install, nothing for the customer to
         approve. It only takes effect once we are the app's installer of record,
         which we become the first time we install an update ourselves. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- TV boxes have no touchscreen; declare both optional so one APK installs on
         Android-TV boxes/sticks AND touch tablets. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".PlayerApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Player">

        <!-- The kiosk WebView. singleTask = one instance (the Android analogue of
             the Tauri single-instance plugin). Handling these config changes keeps
             the WebView alive across rotation / dock / density changes instead of
             recreating (and reloading) the Activity. -->
        <activity
            android:name=".KioskActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Player.Fullscreen">
            <!-- Normal launcher (tablets / phones). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android-TV / leanback launcher (boxes, sticks). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Offers the player as the device's HOME app. Two reasons: the
                 Device-Owner HARD kiosk calls addPersistentPreferredActivity for
                 HOME, which could never resolve to an activity that did not declare
                 the category (so that code path has never done anything); and on a
                 non-Device-Owner box, being chosen as the launcher is the only
                 autostart route that survives a power cut, since the system starts
                 the launcher itself rather than a background app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Autostart on power-up. -->
        <!-- Brings the player back after it updates itself. Without this every
             successful unattended OTA left the screen on the TV's own menu until a
             human power-cycled it: a package replace kills the process and Android
             sends no boot broadcast and revives no sticky service. -->
        <receiver
            android:name=".boot.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The supervisor's pulse: an inexact alarm re-starts the service when
             START_STICKY was not honoured. A supervisor cannot supervise its own
             absence. -->
        <receiver
            android:name=".boot.HeartbeatReceiver"
            android:exported="false" />

        <receiver
            android:name=".boot.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Keep-alive watchdog (foreground service). -->
        <service
            android:name=".boot.WatchdogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Unattended digital-signage kiosk keep-alive watchdog" />
        </service>

        <!-- Own DPC: enables provisioning this app as Device Owner (QR / adb). -->
        <receiver
            android:name=".kiosk.PlayerDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- PackageInstaller session-result callback (Level 3 self-update). -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
