# REST base for the player fallback endpoints (cold boot + offline reconnect).
VITE_API_URL=http://localhost:3000/api/v1

# Socket.IO origin (the gateway namespace `/player` is appended automatically).
VITE_WS_URL=http://localhost:3000

# Optional crash reporting for unattended devices.
VITE_SENTRY_DSN=

# Optional: share of SCREENS that report errors, 0–1. Default 1 (every screen).
# The decision is per device and stable, so a sampled fleet still gives you whole
# stories from a subset rather than fragments from everyone. Turn it down only
# when one fault starts producing hundreds of identical events — at that point the
# duplicates are hiding the single-screen faults that actually need somebody.
VITE_SENTRY_SAMPLE_RATE=

# Optional: origin of the CMS that embeds the live preview. When set, the
# preview postMessage token handshake only accepts the operator token from this
# origin (defense in depth). Leave empty to trust the embedding parent frame.
VITE_CMS_ORIGIN=
