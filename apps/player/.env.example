# REST base for the player fallback endpoints (cold boot + offline reconnect).
VITE_API_URL=http://localhost:3000/api/v1

# Socket.IO origin (the gateway namespace `/player` is appended automatically).
VITE_WS_URL=http://localhost:3000

# Optional crash reporting for unattended devices.
VITE_SENTRY_DSN=

# Optional: origin of the CMS that embeds the live preview. When set, the
# preview postMessage token handshake only accepts the operator token from this
# origin (defense in depth). Leave empty to trust the embedding parent frame.
VITE_CMS_ORIGIN=
