# ─── Phase 0 (scaffold) ───────────────────────────────────────────────
# Public origin of the site — canonicals, hreflang, sitemap, OG urls, JSON-LD ids.
# REQUIRED in production: `next build` fails without it rather than silently
# announcing the whole site as living on localhost. No trailing slash.
# Production value: https://www.signagewall.com
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Set to false on preview/staging deployments. This emits a global noindex
# response header and a robots.txt `Disallow: /`. Production defaults to true.
SEO_INDEXING_ENABLED=true

# Enable only after existing Posts/Solutions have been reviewed and backfilled.
# New documents are fail-closed regardless; this switch removes the temporary
# compatibility allowance for legacy records that lack explicit SEO gates.
SEO_STRICT_CONTENT_GATES=false

# ─── Phase 2 (contact form → Resend) ──────────────────────────────────
# Reuses the same Resend account/conventions as @signagewall/be.
# RESEND_API_KEY=
# MAIL_FROM=
# CONTACT_NOTIFY_TO=

# ─── Phase 3 (Payload CMS: blog + solutions) ──────────────────────────
# Same Mongo cluster as @signagewall/be, but a SEPARATE database (signagewall_web) for isolation.
# DATABASE_URI=mongodb://localhost:27017/signagewall_web
# PAYLOAD_SECRET=
# Same Cloudflare R2 as @signagewall/be; Payload writes under the `web/` key prefix.
# All four of ACCOUNT_ID / ACCESS_KEY_ID / SECRET_ACCESS_KEY / BUCKET must be set
# together — with any of them missing, uploads fall back to the local disk.
# R2_PUBLIC_URL is separate: it is the public read origin, and next.config.ts
# needs it to allow `next/image` to optimise anything served from the bucket.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# ─── Phase 4 (analytics) ──────────────────────────────────────────────
# Google Analytics 4 — gated behind GDPR cookie consent.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── App (@signagewall/cms) origin ───────────────────────────────────────────
# The signage app the header Sign in / Register buttons link to.
NEXT_PUBLIC_APP_URL=http://localhost:5173
