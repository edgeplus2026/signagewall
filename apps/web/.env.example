# The public origin. Also decides indexing: only a production build served from
# CANONICAL_ORIGIN (src/lib/site-url.ts) is crawlable, so preview and staging
# deploys are blocked by their own origin and need no flag of their own.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Publishing gates are enforced by default: a Post/Solution/App Page locale
# version reaches its public URL only once an editor marked it ready and
# indexable. Uncomment only for a bulk import whose records have no decision
# yet — `pnpm seo:gates` reports what either setting exposes.
# SEO_STRICT_CONTENT_GATES=false
RESEND_API_KEY=
MAIL_FROM=
DATABASE_URI=mongodb://localhost:27017/signagewall_web
PAYLOAD_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
NEXT_PUBLIC_APP_URL=http://localhost:5173
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Server-only override when the public API URL is not reachable inside the host.
BACKEND_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_GA_MEASUREMENT_ID=
