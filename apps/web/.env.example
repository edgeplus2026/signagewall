# ─── Phase 0 (scaffold) ───────────────────────────────────────────────
# Public base URL of the site (used for metadata, robots, sitemap, hreflang).
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# ─── Phase 2 (contact form → Resend) ──────────────────────────────────
# Reuses the same Resend account/conventions as @edge/be.
# RESEND_API_KEY=
# MAIL_FROM=
# CONTACT_NOTIFY_TO=

# ─── Phase 3 (Payload CMS: blog + solutions) ──────────────────────────
# Same Mongo cluster as @edge/be, but a SEPARATE database (edge_web) for isolation.
# DATABASE_URI=mongodb://localhost:27017/edge_web
# PAYLOAD_SECRET=
# Same Cloudflare R2 as @edge/be; Payload writes under the `web/` key prefix.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# ─── Phase 4 (analytics) ──────────────────────────────────────────────
# Google Analytics 4 — gated behind GDPR cookie consent.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
